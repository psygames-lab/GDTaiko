{
  "catalog_id": "gdtaiko.default",
  "catalog_version": "1.0.0",
  "game_name": "gdtaiko",
  "mapping_version": "1.0.0",
  "raw_schema_version": "0.2.0",
  "hed_schema_version": "8.3.0",
  "sidecar": "events.json",
  "rules": [
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "song_start"
      },
      "columns": {
        "event_kind": "song_start",
        "duration": 0,
        "observed_timestamp_usec": {
          "path": "payload.observed_timestamp_usec"
        },
        "marker_code": 1
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "song_end"
      },
      "columns": {
        "event_kind": "song_end",
        "duration": 0,
        "reason": {
          "path": "payload.reason"
        },
        "song_time": {
          "path": "payload.last_observed_song_time_sec"
        },
        "score": {
          "path": "payload.result.score"
        },
        "marker_code": 2
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "pause"
      },
      "columns": {
        "event_kind": "pause",
        "duration": 0,
        "song_time": {
          "path": "payload.last_observed_song_time_sec"
        },
        "marker_code": 3
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "resume"
      },
      "columns": {
        "event_kind": "resume",
        "duration": 0,
        "song_time": {
          "path": "payload.last_observed_song_time_sec"
        },
        "marker_code": 4
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "player_response",
        "payload.source": "manual"
      },
      "columns": {
        "event_kind": "manual_response",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "marker_code": 12
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "player_response",
        "payload.source": "replay"
      },
      "columns": {
        "event_kind": "replay_response",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "marker_code": 13
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "note_hit"
      },
      "columns": {
        "event_kind": "note_hit",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "score": {
          "path": "payload.score"
        },
        "combo": {
          "path": "payload.combo"
        },
        "note_id": {
          "path": "payload.note_id"
        },
        "scheduled_time": {
          "path": "payload.scheduled_time_sec"
        },
        "judgment": {
          "path": "payload.judgment"
        },
        "timing_error": {
          "path": "payload.timing_error_ms",
          "scale": 0.001
        },
        "marker_code": 20
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "empty_hit"
      },
      "columns": {
        "event_kind": "empty_hit",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "score": {
          "path": "payload.score"
        },
        "combo": {
          "path": "payload.combo"
        },
        "marker_code": 21
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "note_miss"
      },
      "columns": {
        "event_kind": "note_miss",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "score": {
          "path": "payload.score"
        },
        "combo": {
          "path": "payload.combo"
        },
        "note_id": {
          "path": "payload.note_id"
        },
        "scheduled_time": {
          "path": "payload.scheduled_time_sec"
        },
        "reason": {
          "path": "payload.reason"
        },
        "marker_code": 22
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "roll_hit"
      },
      "columns": {
        "event_kind": "roll_hit",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "score": {
          "path": "payload.score"
        },
        "combo": {
          "path": "payload.combo"
        },
        "note_id": {
          "path": "payload.note_id"
        },
        "scheduled_time": {
          "path": "payload.scheduled_time_sec"
        },
        "hit_count": {
          "path": "payload.hits"
        },
        "marker_code": 23
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "roll_end"
      },
      "columns": {
        "event_kind": "roll_end",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "score": {
          "path": "payload.score"
        },
        "combo": {
          "path": "payload.combo"
        },
        "note_id": {
          "path": "payload.note_id"
        },
        "scheduled_time": {
          "path": "payload.scheduled_time_sec"
        },
        "hit_count": {
          "path": "payload.hits"
        },
        "marker_code": 24
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "balloon_hit"
      },
      "columns": {
        "event_kind": "balloon_hit",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "score": {
          "path": "payload.score"
        },
        "combo": {
          "path": "payload.combo"
        },
        "note_id": {
          "path": "payload.note_id"
        },
        "scheduled_time": {
          "path": "payload.scheduled_time_sec"
        },
        "hit_count": {
          "path": "payload.hits"
        },
        "balloon_cleared": {
          "path": "payload.cleared"
        },
        "marker_code": 25
      }
    },
    {
      "match": {
        "event_type": "gameplay",
        "event_tag": "balloon_end"
      },
      "columns": {
        "event_kind": "balloon_end",
        "duration": 0,
        "input_source": {
          "path": "payload.source"
        },
        "input_index": {
          "path": "payload.input_index"
        },
        "response_lane": {
          "path": "payload.lane"
        },
        "song_time": {
          "path": "payload.song_time_sec"
        },
        "score": {
          "path": "payload.score"
        },
        "combo": {
          "path": "payload.combo"
        },
        "note_id": {
          "path": "payload.note_id"
        },
        "scheduled_time": {
          "path": "payload.scheduled_time_sec"
        },
        "hit_count": {
          "path": "payload.hits"
        },
        "balloon_cleared": {
          "path": "payload.cleared"
        },
        "marker_code": 26
      }
    },
    {
      "match": {
        "event_type": "session",
        "event_tag": "session_start"
      },
      "exclude": "Recorder lifecycle is retained in the raw file and manifest; gameplay song boundaries are exported separately."
    },
    {
      "match": {
        "event_type": "session",
        "event_tag": "session_end"
      },
      "exclude": "Recorder lifecycle is retained in the raw file and manifest; gameplay song boundaries are exported separately."
    },
    {
      "match": {
        "event_type": "marker",
        "event_tag": "marker_sent",
        "payload.marker.driver": "mock"
      },
      "exclude": "Simulated marker transport audit, not another gameplay event or an observed physical EEG trigger; linked source remains in the raw recording."
    }
  ]
}

{
  "catalog_id": "gdtaiko.default",
  "catalog_version": "1.0.0",
  "game_name": "gdtaiko",
  "raw_schema_version": "0.2.0",
  "hed_schema_version": "8.3.0",
  "column_metadata": {
    "onset": {
      "Description": "Software observation time in seconds relative to PsyGodot session origin, not physical display/audio onset.",
      "Units": "s"
    },
    "duration": {
      "Description": "Zero marks a discrete observation or transition; it is not a note, song or pause interval duration.",
      "Units": "s"
    },
    "source_event_id": {
      "Description": "Original event ID within the paired raw session."
    },
    "event_type": {
      "Description": "Original PsyGodot event category."
    },
    "event_tag": {
      "Description": "Original GDTaiko event name."
    },
    "event_kind": {
      "Description": "Offline event classification; judgments describe controller processing, not visual or auditory presentation."
    },
    "input_source": {
      "Description": "Origin of the triggering input or game update.",
      "Levels": {
        "manual": "Live input path.",
        "replay": "Recorded or scripted input path; not a participant response at this observation time.",
        "game": "Autonomous expiry processing."
      }
    },
    "input_index": {
      "Description": "Input sequence within this song. Zero marks autonomous processing; positive values link responses and outcomes."
    },
    "response_lane": {
      "Description": "Game lane or long-note kind, not physical hand or keyboard key."
    },
    "song_time": {
      "Description": "Game-computed song time used by processing; distinct from the monotonic observation time.",
      "Units": "s"
    },
    "scheduled_time": {
      "Description": "Planned note time from the chart, not observed stimulus onset.",
      "Units": "s"
    },
    "observed_timestamp_usec": {
      "Description": "Godot monotonic song-start observation before the recorder session was initialized; retained verbatim.",
      "Units": "us"
    },
    "note_id": {
      "Description": "Note identity within the song, linking judgments and long-note updates."
    },
    "judgment": {
      "Description": "Game timing judgment retained verbatim; does not infer scientific correctness.",
      "Levels": {
        "perfect": "Within the perfect timing window.",
        "good": "Within the good timing window.",
        "bad": "Within the bad timing window."
      }
    },
    "timing_error": {
      "Description": "Signed game-computed input minus planned note time, converted from milliseconds; not reaction time or device latency.",
      "Units": "s"
    },
    "score": {
      "Description": "Game score at the recorded controller operation."
    },
    "combo": {
      "Description": "Game combo at the recorded controller operation."
    },
    "reason": {
      "Description": "Game-reported reason for termination or note expiry."
    },
    "hit_count": {
      "Description": "Registered cumulative hits on this roll or balloon note."
    },
    "balloon_cleared": {
      "Description": "Whether the balloon hit requirement was reached."
    }
  },
  "events": [
    {
      "id": "song_start",
      "match": {
        "event_type": "gameplay",
        "event_tag": "song_start"
      },
      "marker_code": 1,
      "hed": "Experiment-structure, Label/GDTaiko-song-start",
      "columns": {
        "duration": 0,
        "observed_timestamp_usec": {
          "path": "payload.observed_timestamp_usec"
        }
      }
    },
    {
      "id": "song_end",
      "match": {
        "event_type": "gameplay",
        "event_tag": "song_end"
      },
      "marker_code": 2,
      "hed": "Experiment-structure, Label/GDTaiko-song-end",
      "columns": {
        "duration": 0,
        "reason": {
          "path": "payload.reason"
        },
        "song_time": {
          "path": "payload.last_observed_song_time_sec"
        },
        "score": {
          "path": "payload.result.score"
        }
      }
    },
    {
      "id": "pause",
